# Groq API key — used for resume/JD structured extraction + skill-equivalence
# judgment. If unset, the pipeline falls back to offline regex/keyword heuristics
# automatically (see app/parsing/llm_extractor.py) so it always runs.
GROQ_API_KEY=

# Groq model for extraction/judgment calls
GROQ_MODEL=llama-3.3-70b-versatile

# sentence-transformers model for embeddings (separate from the LLM above)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Where Chroma persists its vector DB on disk
CHROMA_PERSIST_DIR=./data/chroma_db
